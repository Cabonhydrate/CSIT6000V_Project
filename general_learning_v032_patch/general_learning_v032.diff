+               'VALUES(?,?,?,?,?,?,?)',(rid,cid,'pending','adaptive',question,'[]',db.now()))
+    return rid,ChatRequest(conversation_id=cid,scope='general',paper_ids=[],question=question,
+                           mode='adaptive',teaching=True,allow_web=True)
+
+
+class SourceModel:
