# Copy to a private file on TACC (chmod 600), then set TACC_CONFIG_FILE.
# Model weights/conda env/partition/account must come from course instructions.
TACC_MODEL_PATH=/REPLACE/WITH/COURSE/MODEL/PATH
TACC_SERVED_MODEL_NAME=qwen3.8-27b
TACC_GPUS=2
TACC_MAX_MODEL_LEN=32768
TACC_MAX_SEQS=4
TACC_GPU_MEMORY_UTILIZATION=0.90
TACC_PORT=8000
# 127.0.0.1 only if the test client runs in the SAME allocation/node.
# 0.0.0.0 for a separately allocated internal client; requires API key, and
# must be permitted by the cluster/course access policy.
TACC_BIND_HOST=127.0.0.1
# Only enable after verifying official TACC policy/network isolation:
# TACC_ALLOW_INTERNAL_BIND=I_HAVE_NETWORK_APPROVAL
TACC_NO_THINKING=1
# Never commit a real API key. For a non-loopback listener set TACC_API_KEY
# through a protected environment variable or a private 0600 env file.
